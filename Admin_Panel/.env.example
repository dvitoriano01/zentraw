# ===============================================
# 🔧 ZENTRAW API MANAGER - CONFIGURATION TEMPLATE
# ===============================================
# ⚠️ SEGURANÇA: Este é um arquivo de exemplo SEGURO
# ⚠️ NUNCA commitar o arquivo .env com chaves reais!

# OpenAI API
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Spotify API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# GitHub API
GITHUB_TOKEN=ghp_your-github-token-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Blender
BLENDER_PATH=C:/blender Files/Blender Foundation/Blender 4.2/blender.exe

# Stripe API
STRIPE_API_KEY=sk_test_your-stripe-key

# Twilio API
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# Google API (exemplo futuro)
GOOGLE_API_KEY=your-google-key

# ===============================================
# 🛡️ ZENTRAW ADMIN PANEL SETTINGS
# ===============================================
NODE_ENV=development
ADMIN_PANEL_PORT=3001
ADMIN_PANEL_SECRET=zentraw-admin-secret-key

# ===============================================
# 📝 INSTRUÇÕES DE USO:
# ===============================================
# 1. Copie este arquivo para .env na raiz do projeto
# 2. Substitua os valores de exemplo pelas suas chaves reais
# 3. Reinicie o Admin Panel para aplicar as configurações
# 4. Use o botão "Abrir" no card API Manager para ver o status
# ===============================================
