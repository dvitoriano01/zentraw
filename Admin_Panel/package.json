{
  "name": "zentraw-admin-panel",
  "version": "1.0.0",
  "description": "Painel de administração central da Zentraw",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build": "npm run lint && npm run test",
    "health": "curl http://localhost:3001/health"
  },
  "keywords": [
    "zentraw",
    "admin",
    "panel",
    "dashboard",
    "monitoring",
    "api",
    "management"
  ],
  "author": "Zentraw Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "node-cron": "^3.0.2",
    "express-rate-limit": "^6.8.1",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "axios": "^1.4.0",
    "ws": "^8.13.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.4.5"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zentraw/admin-panel.git"
  },
  "bugs": {
    "url": "https://github.com/zentraw/admin-panel/issues"
  },
  "homepage": "https://github.com/zentraw/admin-panel#readme",
  "zentraw": {
    "module": "admin-panel",
    "version": "1.0.0",
    "compliance": "ZENTRAW-MASTER-RULES.md",
    "architecture": "MODULE-ARCHITECTURE-STANDARD.md",
    "port": 3001,
    "dependencies": [
      "template-library-builder:3004",
      "3d-visualizer:3005",
      "music-intelligence:3006"
    ]
  }
